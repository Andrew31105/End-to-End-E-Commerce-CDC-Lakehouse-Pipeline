<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Hive Metastore Configuration – warehouse location + S3A (MinIO)
-->
<configuration>
  <!-- Warehouse directory – HMS quản lý metadata cho Iceberg -->
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>s3a://iceberg-datawarehouse/</value>
  </property>

  <!-- S3A / MinIO Configuration -->
  <property>
    <name>fs.s3a.endpoint</name>
    <value>http://minio:9000</value>
  </property>
  <property>
    <name>fs.s3a.access.key</name>
    <value>${env.AWS_ACCESS_KEY_ID}</value>
  </property>
  <property>
    <name>fs.s3a.secret.key</name>
    <value>${env.AWS_SECRET_ACCESS_KEY}</value>
  </property>
  <property>
    <name>fs.s3a.path.style.access</name>
    <value>true</value>
  </property>
  <property>
    <name>fs.s3a.impl</name>
    <value>org.apache.hadoop.fs.s3a.S3AFileSystem</value>
  </property>
  <property>
    <name>fs.s3a.connection.ssl.enabled</name>
    <value>false</value>
  </property>
</configuration>
