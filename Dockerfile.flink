# ============================================================
# Dockerfile for Apache Flink with PyFlink (Python 3) support
# ============================================================
FROM apache/flink:2.3.0-scala_2.12-java11

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

RUN pip3 install --no-cache-dir --break-system-packages \
    apache-flink==2.3.0

USER flink
