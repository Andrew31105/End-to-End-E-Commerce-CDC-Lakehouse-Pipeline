# ============================================================
# Dockerfile for Apache Flink with PyFlink (Python 3) support
# ============================================================
# NOTE: dùng Flink 1.20.1 (thay vì 2.3.0) vì Apache KHÔNG phát hành
# flink-connector-jdbc cho Flink 2.x (mới nhất là 3.4.0-1.20). Bộ connector
# dưới đây khớp chính xác Flink 1.20 và tồn tại trên Maven Central.
FROM apache/flink:1.20.1-scala_2.12-java11

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

RUN pip3 install --no-cache-dir \
    apache-flink==1.20.1

# ------ Connector JARs cho Flink SQL (chỉ Kafka; sink ClickHouse qua Kafka engine) ------
ENV FLINK_LIB=/opt/flink/lib

# Kafka SQL connector (fat jar) – đọc/ghi Kafka topics, hỗ trợ debezium-json format
RUN curl -fsSL https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.4.0-1.20/flink-sql-connector-kafka-3.4.0-1.20.jar \
    -o ${FLINK_LIB}/flink-sql-connector-kafka-3.4.0-1.20.jar

# (Không cần flink-connector-jdbc/clickhouse-jdbc: chúng KHÔNG hỗ trợ ClickHouse
#  dialect. Thay vào đó Flink ghi ra Kafka topic rồi ClickHouse tiêu thụ qua
#  Kafka engine table + Materialized View – xem sql/clickhouse/init.sql)

USER flink

