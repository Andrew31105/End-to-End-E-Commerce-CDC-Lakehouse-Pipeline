# ============================================================
# Dockerfile for Apache Flink with PyFlink (Python 3) support
# ============================================================
# NOTE: dùng Flink 1.20.1 (thay vì 2.3.0) vì Apache KHÔNG phát hành
# flink-connector-jdbc cho Flink 2.x (mới nhất là 3.4.0-1.20). Bộ connector
# dưới đây khớp chính xác Flink 1.20 và tồn tại trên Maven Central.
FROM apache/flink:1.20.1-scala_2.12-java11

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

RUN pip3 install --no-cache-dir \
    apache-flink==1.20.1

# ------ Connector JARs cho Flink SQL (Kafka, JDBC, ClickHouse) ------
ENV FLINK_LIB=/opt/flink/lib

# Kafka SQL connector (fat jar) – đọc/ghi Kafka topics, hỗ trợ debezium-json format
RUN curl -fsSL https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.4.0-1.20/flink-sql-connector-kafka-3.4.0-1.20.jar \
    -o ${FLINK_LIB}/flink-sql-connector-kafka-3.4.0-1.20.jar

# JDBC connector (fat jar) – ghi kết quả vào ClickHouse qua JDBC
RUN curl -fsSL https://repo1.maven.org/maven2/org/apache/flink/flink-connector-jdbc/3.4.0-1.20/flink-connector-jdbc-3.4.0-1.20.jar \
    -o ${FLINK_LIB}/flink-connector-jdbc-3.4.0-1.20.jar

# ClickHouse JDBC driver
RUN curl -fsSL https://repo1.maven.org/maven2/com/clickhouse/clickhouse-jdbc/0.6.0/clickhouse-jdbc-0.6.0-all.jar \
    -o ${FLINK_LIB}/clickhouse-jdbc-0.6.0-all.jar

USER flink

