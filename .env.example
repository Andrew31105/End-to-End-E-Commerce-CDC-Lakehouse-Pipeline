# ============================================================
#  .env.example – Bản mẫu cấu hình
#  Sao chép thành `.env` rồi điền giá trị (`.env` đã bị gitignore):
#      cp .env.example .env
# ============================================================

# ---------- PostgreSQL (Transactional Source + CDC) ----------
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Chỉ dùng cho tool trên HOST (mock_data...). Trong compose là postgres:5432.
PG_HOST=localhost
PG_PORT=5432

# ---------- MinIO (Object Storage / Data Lake) ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- ClickHouse (OLAP Serving) ----------
CLICKHOUSE_DB=ecommerce
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Feature Store API trên host: native port đã map 9002 -> container 9000
CLICKHOUSE_NATIVE_PORT=9002

# ---------- Trino (Feature Store API trên host) ----------
TRINO_HOST=localhost
TRINO_PORT=8084

# ---------- Spark resources (worker) ----------
SPARK_CORE=2
SPARK_MEMORY=2g

# ---------- Airflow (Orchestrator) ----------
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Webserver + scheduler phải dùng CHUNG secret key mới đọc được log (đã fix)
AIRFLOW_SECRET_KEY=CHANGE_ME_RANDOM_SECRET

# ---------- Hive Metastore (Iceberg Catalog) ----------
HIVE_METASTORE_DB=metastore
HIVE_METASTORE_DB_USER=hive
HIVE_METASTORE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- Superset (BI, mặc định admin/admin) ----------
SUPERSET_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# ---------- ML demo (tuỳ chọn) ----------
# FEATURE_API_URL=http://127.0.0.1:8000
